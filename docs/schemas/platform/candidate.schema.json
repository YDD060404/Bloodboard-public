{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate",
  "type": "object",
  "required": [
    "id",
    "position",
    "team",
    "family",
    "kind",
    "label",
    "legal",
    "input"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "team": {
      "enum": [
        "A",
        "B"
      ]
    },
    "family": {
      "enum": [
        "move",
        "standUp",
        "secure",
        "block",
        "blitz",
        "pass",
        "handoff",
        "foul",
        "ttm",
        "special",
        "endActivation",
        "endTurn"
      ]
    },
    "kind": {
      "type": "string"
    },
    "actorId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "label": {
      "type": "string"
    },
    "input": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "playerAction",
                "endActivation",
                "endTurn"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x",
          "y",
          "kind"
        ],
        "properties": {
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "destination": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "legal": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rushes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "dodges": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "exact": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "pSuccess": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "pTurnover": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "pTouchdown": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "pOpponentTouchdown": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "builtIn": {}
  },
  "additionalProperties": true
}
