{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observation",
  "type": "object",
  "required": [
    "apiMinor",
    "team",
    "players",
    "ball",
    "score",
    "turn",
    "turnsPerHalf",
    "half",
    "weather",
    "phase",
    "rerolls",
    "requestId",
    "active",
    "pending"
  ],
  "properties": {
    "apiMinor": {
      "type": "integer"
    },
    "requestId": {
      "type": "integer"
    },
    "team": {
      "enum": [
        "A",
        "B"
      ]
    },
    "format": {
      "type": "string"
    },
    "pitch": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "team",
          "location",
          "stance",
          "ma",
          "st",
          "ag",
          "pa",
          "av"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "team": {
            "enum": [
              "A",
              "B"
            ]
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "stance": {
            "type": "string"
          },
          "pos": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ma": {
            "type": "integer"
          },
          "st": {
            "type": "integer"
          },
          "ag": {
            "type": "integer"
          },
          "pa": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "av": {
            "type": "integer"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activated": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "ball": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "held",
            "ground",
            "none",
            "inAir"
          ]
        }
      },
      "additionalProperties": true
    },
    "score": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "type": "integer"
        },
        "B": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "turn": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "type": "integer"
        },
        "B": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "turnsPerHalf": {
      "type": "integer"
    },
    "half": {
      "type": "integer"
    },
    "weather": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "rerolls": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "type": "integer"
        },
        "B": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "active": {
      "enum": [
        "A",
        "B"
      ]
    },
    "pending": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "requestId",
            "type",
            "team",
            "options"
          ],
          "properties": {
            "requestId": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "team": {
              "enum": [
                "A",
                "B"
              ]
            },
            "prompt": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "context": {}
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "activation": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "playerId"
          ],
          "properties": {
            "playerId": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
